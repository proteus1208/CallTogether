{
  "manifest_version": 3,
  "name": "CallTogether",
  "version": "1.3.1",
  "description": "Live call transcript float + hotkey paste into AI chat.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "offscreen",
    "windows"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "CallTogether",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel/*"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
