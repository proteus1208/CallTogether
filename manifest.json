{
  "manifest_version": 3,
  "name": "CallTogether",
  "version": "1.2.1",
  "description": "Capture system/tab call audio for free, show a live floating transcript on the AI page, and paste with a hotkey.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "desktopCapture"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "CallTogether",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "panel/*",
        "models/*",
        "vendor/vosk/*"
      ],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
